# Copy to .env.local for local dev. Never commit real values.

# Neon: `neon deploy` pulls these into .env.local (pooled for the app, direct for migrations).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# openssl rand -base64 32  (must decode to 32 bytes)
DB_ENC_KEY=
# openssl rand -hex 32
SESSION_SECRET=
NIGHT_SECRET=
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Chain. Chronicle lives on MONAD_RPC_URL. Set CHOG_RPC_URL if the Chog NFT is on another network.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CHOG_RPC_URL=
CHOG_NFT_ADDRESS=
# Defaults to the deployed testnet Chronicle in lib/contracts.ts
CHRONICLE_ADDRESS=
# Two different wallets. The relayer holds only a small MON balance for gas.
VOUCHER_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Narration goes through the Neon AI Gateway. AI_API_KEY (direct Anthropic) is a fallback.
# With neither, diary text uses a built-in template.
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Public URL of the app. The Neon scheduler function calls APP_URL/api/cron/*.
APP_URL=http://localhost:3000

# Shown as the landing page "Open in Telegram" link
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
