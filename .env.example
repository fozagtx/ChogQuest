# Secrets only. Public settings (chain, contracts, bot username, AI model) are in lib/config.ts.
# Copy to .env.local for local dev. Never commit real values.

# Neon: `neon deploy` pulls these into .env.local (pooled for the app, direct for migrations).
DATABASE_URL=
# Optional: derived from DATABASE_URL by dropping "-pooler" when unset.
DATABASE_URL_UNPOOLED=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# openssl rand -base64 32  (must decode to 32 bytes)
DB_ENC_KEY=
# openssl rand -hex 32
SESSION_SECRET=
CRON_SECRET=
TELEGRAM_WEBHOOK_SECRET=

# Narration goes through the Neon AI Gateway. AI_API_KEY (direct Anthropic) is a fallback.
# With neither, diary text uses a built-in template.
AI_API_KEY=

TELEGRAM_BOT_TOKEN=

# Public URL of the app. On Render it defaults to RENDER_EXTERNAL_URL.
# The Neon scheduler function is deployed with this value and calls APP_URL/api/cron/evening.
APP_URL=http://localhost:3000
